{
  "name": "Customer Churn Prediction",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "app.py"] },
    "vscode": { "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff", "ms-toolsai.jupyter"] }
  },
  "updateContentCommand": "pip install -r requirements.txt && pip install -e '.[dev]'",
  "postAttachCommand": "streamlit run app.py --server.enableCORS false --server.enableXsrfProtection false",
  "forwardPorts": [8501],
  "portsAttributes": { "8501": { "label": "Churn Predictor", "onAutoForward": "openPreview" } }
}
